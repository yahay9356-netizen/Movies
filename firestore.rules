rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'avatarIndex', 'watchlist', 'history', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'phone', 'avatarIndex', 'watchlist', 'history', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && data.avatarIndex is number && data.avatarIndex >= 0 && data.avatarIndex < 20
        && data.watchlist is list && data.watchlist.size() <= 100
        && data.history is list && data.history.size() <= 100
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
