{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, watchlist, and watch history",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "avatarIndex": { "type": "number" },
        "watchlist": { "type": "array" },
        "history": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "avatarIndex", "watchlist", "history", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, watchlist, and watch history"
    }
  }
}
